# HomeDeliveryClaims.com service settings. Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env
# Never commit .env. Values containing a $ sign MUST be wrapped in 'single
# quotes' (Docker Compose expands $ otherwise and silently cuts the value).
# docs/SETUP.md explains where each value comes from.

# --- Site ---

# Public origin used in every link we send (claim links, webhooks). No trailing slash.
PUBLIC_BASE_URL=https://homedeliveryclaims.com

# Docker Compose sets NODE_ENV, HOST, PORT, DATA_DIR and BOARD_CONFIG_PATH itself
# (deploy/docker-compose.yml). These lines only matter for local development.
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# DATA_DIR=./data
# BOARD_CONFIG_PATH=./config/board.json

# info for production; debug when investigating. Never logs message bodies or tokens.
LOG_LEVEL=info

# --- Secrets generated by you ---

# Signs claim links, CSRF tokens and cookies. At least 32 characters.
# Generate:  openssl rand -base64 48
# Changing it later breaks every claim link already emailed and signs everyone out.
APP_SECRET=

# Secret path segment of the webhook URLs (/webhooks/monday/<secret>,
# /webhooks/highlevel/<secret>). At least 16 characters, letters and digits only.
# Generate:  openssl rand -hex 24
# After changing it, re-run the Monday webhook setup and update the HighLevel workflows.
WEBHOOK_SECRET=

# --- Admin page (/admin) ---

ADMIN_USER=admin
# Generate with:  npm run hash-password   (or, on the server:
#   docker compose run --rm --no-deps app node dist/scripts/hash-password.js)
# Paste it in SINGLE quotes, e.g. ADMIN_PASSWORD_HASH='scrypt$abc...$def...'
ADMIN_PASSWORD_HASH=''

# --- Monday.com ---

# Personal API token of the integration user (Profile picture > Developers > My access tokens).
MONDAY_API_TOKEN=
# Pinned API version. Check monday's versioning page before changing it.
MONDAY_API_VERSION=2026-10
# User id of that same integration user. Updates it posts are never sent to claimants.
# `npm run monday:setup -- check` confirms it matches the token.
MONDAY_INTEGRATION_USER_ID=
# Only for webhooks created with a monday app's OAuth token (they carry a signed
# JWT). Leave empty when webhooks are created with the personal token above:
# then the secret URL is the only check.
MONDAY_SIGNING_SECRET=

# --- HighLevel (LeadConnector) sub-account ---

# Sub-account Private Integration Token (Settings > Private Integrations).
HIGHLEVEL_API_TOKEN=
# Sub-account (location) id: Settings > Business Profile, or the URL (/location/<id>/...).
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_API_VERSION=2021-07-28
# Sender address on a verified sending domain, e.g. claims@mail.homedeliveryclaims.com
HIGHLEVEL_EMAIL_FROM=
HIGHLEVEL_EMAIL_FROM_NAME=Home Delivery Claims
# Documents & Contracts template id of the settlement agreement
# (`npm run highlevel:setup -- check` lists the templates and their ids).
HIGHLEVEL_SETTLEMENT_TEMPLATE_ID=
# HighLevel user the settlement document is sent as (listed by the same check).
HIGHLEVEL_USER_ID=
# Ed25519 public key for x-ghl-signature on marketplace webhooks. The default is
# HighLevel's published key; only set this if HighLevel publishes a new one.
# HIGHLEVEL_WEBHOOK_PUBLIC_KEY=MCowBQYDK2VwAyEAi2HR1srL4o18O8BRa7gVJY7G7bupbN3H9AwJrHCDiOg=

# Keep false until the A2P 10DLC brand and campaign are approved. Email still goes out.
SMS_ENABLED=false

# --- Limits ---

# Largest single file a claimant may upload on the claim page, in bytes (25 MB).
# Caddy caps a whole request at 30 MB (deploy/Caddyfile).
MAX_UPLOAD_BYTES=26214400
